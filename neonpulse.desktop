[Desktop Entry]
Version=1.0
Type=Application
Name=NeonPulse Player
GenericName=Music Player
Comment=Lokalny odtwarzacz muzyki z MPRIS i smart playlistami
Exec=/usr/local/bin/neonpulse %U
Icon=neonpulse-player
Terminal=false
